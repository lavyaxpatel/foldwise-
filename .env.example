# FoldWise LLM Configuration
# Provide EITHER Gemini or an OpenAI-compatible key.
# Without a key, FoldWise runs in clearly labelled Simulated Origami AI mode.

PORT=3001

# Option 1: Google Gemini API (Recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
